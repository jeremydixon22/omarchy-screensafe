#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
python3 "$root/scripts/build-native.py" "$work/bin" "$@"
for arch in x86_64 aarch64; do
  for kind in cache sandbox media; do
    cmp "$root/bin/screensafe-$kind-$arch" "$work/bin/screensafe-$kind-$arch"
  done
done
cmp "$root/bin/native-build.json" "$work/bin/native-build.json"
echo 'All six native helpers and their build manifest match the pinned source.'
