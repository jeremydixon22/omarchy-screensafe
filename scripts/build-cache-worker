#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:?usage: build-cache-worker OUTPUT}
pkg-config --exists mpv egl gl gbm libseccomp
cc -std=c11 -O2 -Wall -Wextra -Werror -Wno-misleading-indentation \
  -fstack-protector-strong -D_FORTIFY_SOURCE=3 -Wl,-z,relro,-z,now \
  "$root/cache/native/worker.c" -o "$out" $(pkg-config --cflags --libs mpv egl gl gbm libseccomp)
